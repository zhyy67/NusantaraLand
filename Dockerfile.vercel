FROM dunglas/frankenphp:1-php8.4-bookworm

# Salin Composer dari image resmi Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Install ekstensi PHP yang dibutuhkan Laravel & Database
RUN install-php-extensions intl zip bcmath pdo_mysql

# Copy seluruh kode proyek ke dalam container
WORKDIR /app
COPY . .

# Install dependensi Composer (sekarang perintah 'composer' sudah tersedia)
RUN composer install --no-dev --optimize-autoloader

# Atur permission folder yang bisa ditulis
RUN chown -R www-data:www-data /app/storage /app/bootstrap/cache

# Salin konfigurasi Caddy
COPY Caddyfile /etc/frankenphp/Caddyfile

# Jalankan FrankenPHP
CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]